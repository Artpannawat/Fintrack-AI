# ============================================================
# FinTrack-AI Root .gitignore
# SECURITY: Ensure no secrets are committed
# ============================================================

# --- Environment / Secrets (NEVER COMMIT) ---
**/.env
**/.env.local
**/.env.*.local
**/environment.prod.ts

# --- Dependencies ---
**/node_modules/

# --- Build Outputs ---
**/dist/
**/.angular/

# --- OS Files ---
.DS_Store
Thumbs.db

# --- Logs ---
*.log
npm-debug.log*
yarn-error.log*

# --- IDE ---
.vscode/*
!.vscode/settings.json
.idea/
